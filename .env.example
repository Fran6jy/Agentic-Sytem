# OpenRouter setup (keys starting with sk-or- auto-select the OpenRouter base URL)
OPENAI_API_KEY=your_openrouter_api_key_here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Comma-separated fallback chains: free models get rate-limited or retired, so the
# server tries each in order and falls back to the local toolkit if all fail.
OPENAI_MODEL=nvidia/nemotron-3-super-120b-a12b:free,qwen/qwen3.8-27b:free,google/gemma-4-31b-it:free
OPENAI_VISION_MODEL=qwen/qwen3.8-27b:free,google/gemma-4-31b-it:free
MODEL_TIMEOUT_MS=60000
OPENROUTER_APP_NAME=Chalk Lab AI Math Tutor
OPENROUTER_APP_URL=https://chalklab.vercel.app
# Production hardening: allowed cross-origin sites (same-origin always works) and per-IP limit.
ALLOWED_ORIGINS=
RATE_LIMIT_PER_MINUTE=20
PORT=8787
